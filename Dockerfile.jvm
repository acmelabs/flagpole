# JVM fallback image (faster to build, no GraalVM needed).
#   docker build -f Dockerfile.jvm -t flagpole:jvm .

FROM eclipse-temurin:21-jdk AS build
WORKDIR /build
COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties openapi.properties ./
COPY gradle gradle
RUN ./gradlew --no-daemon -q dependencies > /dev/null
COPY src src
RUN ./gradlew --no-daemon installDist -x test

FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 flagpole
COPY --from=build /build/build/install/flagpole /app
USER 10001
ENV FLAGS_FILE=/config/flags.yaml
ENV LOG_FORMAT=json
EXPOSE 8080
ENTRYPOINT ["/app/bin/flagpole"]
